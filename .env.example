[TEMPLATE]
# Supabase - used ONLY to call the rsvp-notify Edge Function, which emails
# najir74680@gmail.com when a guest RSVPs. No database storage is used.
# 1. Create a free project at https://supabase.com
# 2. Deploy the edge function (see supabase/functions/rsvp-notify/index.ts)
#    with: npx supabase functions deploy rsvp-notify --no-verify-jwt
#    and set its secrets: GMAIL_USER, GMAIL_APP_PASS, NOTIFY_TO, RSVP_AUTH
# 3. Copy this file to .env.local and paste your values from
#    Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
